# For PostgreSQL, uncomment and set your own credentials:
# DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/taskflow_db
# For easy first-run demo, SQLite is used automatically when DATABASE_URL is not set.
APP_SECRET=replace-this-with-a-long-random-secret-before-deployment
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
